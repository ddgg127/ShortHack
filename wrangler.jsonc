{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "short-hack-pulse",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "YANDEX_MODEL_URI": "gpt://b1gnpvn6j1rr6h180c09/yandexgpt/latest"
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "127001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
